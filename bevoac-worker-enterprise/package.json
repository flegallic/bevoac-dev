{
  "name": "bevoac-worker-enterprise",
  "version": "6.2.0-client-ready-controlled-production",
  "description": "Enterprise worker for Bevoac SaaS security scans.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "check": "node scripts/runtime-deps-check.js && node scripts/syntax-check.js",
    "dlq:stats": "node scripts/dlq-stats.js",
    "dlq:replay": "node scripts/dlq-replay.js",
    "test": "node scripts/run-tests.js",
    "audit:security": "npm audit --audit-level=high",
    "sbom": "node ../scripts/ci/generate-cyclonedx-from-lock.js --project-dir . --output ../evidence/sbom/worker.cdx.json --omit-dev"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@azure/arm-appservice": "^18.0.0",
    "@azure/arm-compute": "^23.3.0",
    "@azure/arm-keyvault": "^5.0.0",
    "@azure/arm-network": "^36.0.0",
    "@azure/arm-operationalinsights": "^10.1.0",
    "@azure/arm-policy": "^7.0.0",
    "@azure/arm-postgresql-flexible": "^9.0.0",
    "@azure/arm-security": "^5.0.0",
    "@azure/arm-sql": "^10.0.0",
    "@azure/arm-storage": "^19.1.0",
    "@azure/identity": "^4.13.1",
    "@azure/service-bus": "^7.9.5",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.3.1",
    "isomorphic-fetch": "^3.0.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "xml2js": "^0.6.2"
  },
  "bevoacReleaseRevision": "R2.1",
  "overrides": {
    "ajv": {
      "fast-uri": "3.1.6"
    },
    "fast-xml-parser": "5.10.1"
  },
  "bevoacResourceGraphTransport": "arm-rest-2024-04-01"
}
