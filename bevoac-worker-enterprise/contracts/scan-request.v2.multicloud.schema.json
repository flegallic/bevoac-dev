{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bevoac.example/contracts/scan-request.v2.multicloud.schema.json",
  "title": "Bevoac multicloud scan request contract V2 - declared for V6.3.0 and not runtime-enabled in V6.2.0",
  "type": "object",
  "required": [
    "version",
    "scanId",
    "tenantId",
    "cloudProvider",
    "scanProfile",
    "modules",
    "targets",
    "limits",
    "requestedAt"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "scanId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "cloudProvider": {
      "type": "string",
      "enum": [
        "azure",
        "aws",
        "gcp"
      ]
    },
    "scanProfile": {
      "type": "string",
      "enum": [
        "web",
        "entra",
        "infra",
        "full"
      ]
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "object",
      "properties": {
        "web": {
          "type": [
            "object",
            "null"
          ]
        },
        "azure": {
          "type": [
            "object",
            "null"
          ]
        },
        "aws": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
