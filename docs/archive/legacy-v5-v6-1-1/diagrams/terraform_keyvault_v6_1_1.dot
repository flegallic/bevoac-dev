digraph G {

  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.55"];
  node [shape=box, style="rounded,filled", color="#6A8CAF", penwidth=1.4, fillcolor="#DDEBF7", fontname="Helvetica", fontsize=11, margin="0.11,0.08"];
  edge [color="#4F6F8F", arrowsize=0.8, penwidth=1.2, fontname="Helvetica", fontsize=9];

  Mac [label="Mac hors VNet", fillcolor="#FCE4D6"];
  KV [label="Key Vault prive"];
  EX [label="Exception POC
ouverture IP temporaire", fillcolor="#FFF2CC"];
  Runner [label="Runner prive / VM / VPN", fillcolor="#E2F0D9"];
  DNS [label="Private DNS"];
  TF [label="terraform plan/apply"];
  PG [label="PostgreSQL prive"];
  Mac->KV [style=dashed, label="ForbiddenByConnection"];
  Mac->EX->KV; Runner->DNS->KV; Runner->TF->PG; TF->KV;
}