digraph G {

  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.55"];
  node [shape=box, style="rounded,filled", color="#6A8CAF", penwidth=1.4, fillcolor="#DDEBF7", fontname="Helvetica", fontsize=11, margin="0.11,0.08"];
  edge [color="#4F6F8F", arrowsize=0.8, penwidth=1.2, fontname="Helvetica", fontsize=9];

  API [label="API creation scan"];
  OUT [label="outbox_events
PENDING / FAILED", shape=cylinder, fillcolor="#FFF2CC"];
  PUB [label="Dedicated outbox publisher
ca-*-outbox
poll + retry"];
  SB [label="Service Bus
scan-jobs"];
  W [label="Worker"];
  OK [label="outbox_events
PUBLISHED", shape=cylinder, fillcolor="#E2F0D9"];
  KO [label="FAILED + next_attempt_at
last_error", fillcolor="#FCE4D6"];
  API->OUT->PUB->SB->W; PUB->OK; PUB->KO [style=dashed];
}