digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#1F4E78", fontname="Arial", fontsize=10, margin="0.12,0.08"];
  edge [color="#4F6D7A", penwidth=1.2, arrowsize=0.8, fontname="Arial", fontsize=9];

  api [label="public_api
no Service Bus secret"];
  tx [label="Single PostgreSQL transaction"];
  scans [label="scans", shape=cylinder, fillcolor="#FCF3CF"];
  evt [label="outbox_events PENDING", shape=cylinder, fillcolor="#FCF3CF"];
  out [label="outbox runtime
SELECT + UPDATE"];
  sb [label="Service Bus Sender", fillcolor="#D5F5E3"];
  worker [label="worker Receiver"];
  pub [label="PUBLISHED", fillcolor="#D5F5E3"];
  fail [label="FAILED + backoff", fillcolor="#FADBD8"];
  api -> tx; tx -> scans; tx -> evt; evt -> out; out -> sb -> worker; out -> pub; out -> fail;
}
