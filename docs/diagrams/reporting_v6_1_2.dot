digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#1F4E78", fontname="Arial", fontsize=10, margin="0.12,0.08"];
  edge [color="#4F6D7A", penwidth=1.2, arrowsize=0.8, fontname="Arial", fontsize=9];
  result [label="scan_results\nJSON + summary + SHA256", shape=cylinder, fillcolor="#FCF3CF"];
  api [label="API tenant-scoped"];
  kpi [label="KPI Scorecard"];
  json [label="Explicit JSON result"];
  pdf [label="Bounded PDF\nexecutive + findings + remediation + evidence"];
  client [label="Client / CTO / RSSI", fillcolor="#FDEBD0"];
  result -> api -> json -> client; result -> kpi -> pdf -> client; result -> pdf;
}
