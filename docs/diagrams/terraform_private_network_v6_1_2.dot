digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#1F4E78", fontname="Arial", fontsize=10, margin="0.12,0.08"];
  edge [color="#4F6D7A", penwidth=1.2, arrowsize=0.8, fontname="Arial", fontsize=9];

  graph [rankdir=TB];
  current [label="Observed transition
PG/KV public + firewall", fillcolor="#FADBD8"];
  plan [label="Controlled migration plan"];
  subnet [label="Private endpoint subnet"];
  pg [label="PostgreSQL PE"];
  kv [label="Key Vault PE"];
  dnspg [label="Private DNS PostgreSQL"];
  dnsv [label="Private DNS Key Vault"];
  vnet [label="VNet links"];
  aca [label="Container Apps Environment"];
  admin [label="Private runner / VPN"];
  close [label="Disable public access
remove firewall", fillcolor="#D5F5E3"];
  current -> plan -> subnet; subnet -> pg -> dnspg -> vnet; subnet -> kv -> dnsv -> vnet; vnet -> aca -> close; vnet -> admin -> close;
}
