digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#1F4E78", fontname="Arial", fontsize=10, margin="0.12,0.08"];
  edge [color="#4F6D7A", penwidth=1.2, arrowsize=0.8, fontname="Arial", fontsize=9];

  graph [rankdir=TB];
  start [label="POST onboarding start"];
  session [label="Short session
HMAC state + nonce"];
  consent [label="Microsoft admin consent"];
  callback [label="Callback
state + expiry + anti-replay"];
  verify [label="Verify tenant + Azure RBAC"];
  scope [label="Upsert integration/scopes
VERIFIED / NEEDS_RBAC"];
  redirect [label="Frontend redirect"];
  start -> session -> consent -> callback -> verify -> scope -> redirect;
}
