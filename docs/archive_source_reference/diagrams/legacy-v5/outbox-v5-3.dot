
digraph G { graph [rankdir=LR, bgcolor="white", nodesep="0.3", ranksep="0.35"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#365F91", fillcolor="#D9EAF7"]; edge [color="#365F91"];
api [label="API\ncréation scan"];
