{
  "name": "bevoac-api-enterprise",
  "version": "6.1.3-production-ready",
  "description": "Enterprise SaaS control plane API for audit scan orchestration, tenant management, and billing governance.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "check": "node scripts/runtime-deps-check.js && node scripts/syntax-check.js && node scripts/sync-contracts.js",
    "test": "node --test tests/**/*.test.js",
    "migrate-db": "node scripts/migrate-db.js",
    "outbox-publisher": "node scripts/outbox-publisher.js",
    "init-db": "node scripts/init-db.js",
    "retention-sweep": "node scripts/retention-sweep.js",
    "check-db": "node scripts/check-db.js",
    "create-tenant": "node scripts/create-tenant.js",
    "reset-db": "node scripts/reset-db.js",
    "register-tenant-scope": "node scripts/register-tenant-scope.js",
    "register-web-target": "node scripts/register-web-target.js",
    "onboarding-status": "node scripts/onboarding-status.js",
    "expire-onboarding-sessions": "node scripts/expire-onboarding-sessions.js",
    "outbox-publisher:daemon": "node scripts/outbox-publisher-daemon.js",
    "check:tenant-isolation": "node scripts/check-tenant-isolation.js",
    "backfill:billing": "node scripts/backfill-final-billing-state.js",
    "backfill:billing:dry-run": "node scripts/backfill-final-billing-state.js --dry-run",
    "check:rls": "node scripts/verify-runtime-db-structure.js",
    "check:enterprise-hardening": "node scripts/check-enterprise-hardening.js",
    "check:image": "node scripts/runtime-deps-check.js && node scripts/syntax-check.js && node scripts/sync-contracts.js --api-only",
    "migrate-db:secure-api-key-auth": "node scripts/apply-secure-api-key-auth.js",
    "migrate-db:runtime-role-rls": "node scripts/apply-runtime-role-rls.js",
    "sync-db:runtime-roles": "node scripts/sync-runtime-db-roles.js",
    "check-db:runtime-boundary": "node scripts/verify-runtime-db-structure.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/service-bus": "^7.9.5",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.10.0",
    "pdfmake": "0.2.20",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "xmldoc": "^1.3.0"
  }
}
